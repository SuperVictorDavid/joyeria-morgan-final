# ============================================================
#  Joyeria Morgan - .gitignore
# ============================================================

# ---------- Java / Gradle / Maven ----------
**/build/
**/target/
**/.gradle/
**/out/
*.class
*.jar
!**/gradle/wrapper/gradle-wrapper.jar
*.war
*.ear
hs_err_pid*
replay_pid*

# ---------- Node / Angular ----------
node_modules/
dist/
.angular/
coverage/
*.tsbuildinfo
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# ---------- IDE ----------
.idea/
*.iml
*.ipr
*.iws
.vscode/
*.suo
*.user
*.userosscache
*.sln.docstates

# ---------- Sistema operativo ----------
Thumbs.db
ehthumbs.db
Desktop.ini
.DS_Store

# ---------- Logs y temporales ----------
*.log
logs/
tmp/
temp/
*.tmp
*.bak
*.swp

# ---------- Entorno y secretos ----------
.env
.env.*
!.env.example
*.pem
*.key
*.p12
*.pfx
*.jks

# ---------- Compresos y volcados ----------
*.zip
*.rar
*.7z

# ---------- Datos locales de Docker ----------
mysql-data/
