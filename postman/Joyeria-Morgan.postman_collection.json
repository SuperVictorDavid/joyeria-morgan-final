              "mode": "raw",
              "raw": "{\n  \"username\": \"admin\",\n  \"email\": \"admin@joyeriamorgan.pe\",\n  \"password\": \"admin123\",\n  \"role\": \"ADMIN\"\n}"
            },
            "url": {
              "raw": "{{authUrl}}/users",
              "host": [
                "{{authUrl}}"
              ],
              "path": [
                "users"
              ]
            },
            "description": "Público para el primer usuario (201 o 409 si existe)"
          }
        },
        {
          "name": "Login - Obtener JWT",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Login 200 + token', function(){ pm.response.to.have.status(200); const b = pm.response.json(); pm.expect(b.token).to.be.a('string'); });",
                  "const b = pm.response.json(); pm.environment.set('jwt_token', b.token || b);"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
