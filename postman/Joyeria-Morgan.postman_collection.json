{
  "info": {
    "name": "Joyeria Morgan - Proyecto Final",
    "_postman_id": "joyeria-morgan-final-001",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
    "description": "Colección estilo curso: Auth JWT + Inventario + Clientes + Ventas (Kafka/Rabbit/Feign/CB) + Reportes + Gateway + Eureka + Actuator. Importar junto al environment Joyeria Local."
  },
  "variable": [
    {
      "key": "authUrl",
      "value": "http://localhost:8083"
    },
    {
      "key": "inventarioUrl",
      "value": "http://localhost:8081"
    },
    {
      "key": "ventasUrl",
      "value": "http://localhost:8082"
    },
    {
      "key": "clientesUrl",
      "value": "http://localhost:8084"
    },
    {
      "key": "reportesUrl",
      "value": "http://localhost:8085"
    },
    {
      "key": "gatewayUrl",
      "value": "http://localhost:8762"
    },
    {
      "key": "eurekaUrl",
      "value": "http://localhost:8761"
    }
  ],
  "auth": {
    "type": "bearer",
    "bearer": [
      {
        "key": "token",
        "value": "{{jwt_token}}",
        "type": "string"
      }
    ]
  },
  "event": [
    {
      "listen": "prerequest",
      "script": {
        "type": "text/javascript",
        "exec": [
          "// Si no hay token, inicia sesion con admin para poblar jwt_token",
          "if (!pm.environment.get('jwt_token')) {",
          "  pm.sendRequest({",
          "    url: pm.collectionVariables.get('authUrl') + '/auth/login',",
          "    method: 'POST',",
          "    header: { 'Content-Type': 'application/json' },",
          "    body: { mode: 'raw', raw: JSON.stringify({ username: 'admin', password: 'admin123' }) }",
          "  }, function (err, res) {",
          "    if (!err && res.code === 200) {",
          "      var b = res.json();",
          "      pm.environment.set('jwt_token', b.token || b);",
          "    }",
          "  });",
          "}"
        ]
      }
    }
  ],
