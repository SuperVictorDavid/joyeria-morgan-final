# Copia este archivo como .env (mismo directorio) antes de levantar la infraestructura.
#   cd database
#   copy .env.example .env
#   docker compose --env-file .env up -d

DB_IMAGE=mysql:8.0
DB_HOST=joyeria-mysql
DB_PORT=5510
DB_NAME=joyeria_db
DB_USER=app
DB_PASSWD=password

DB_IMAGE_PHPMA=phpmyadmin/phpmyadmin:latest
DB_HOST_PHPMA=joyeria.phpmyadmin
DB_PORT_PHPMA=3410
